{
  "name": "dusk-star-theme",
  "displayName": "Dusk Star Theme",
  "description": "A dark and light Monokai-inspired theme for VS Code.",
  "version": "0.2.0",
  "publisher": "tonyx",
  "engines": {
    "vscode": "^1.81.0"
  },
  "icon": "./imgs/sun.png",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "monokai",
    "color theme",
    "light theme",
    "dark theme",
    "icon theme",
    "folder icons",
    "dusk",
    "star",
    "dusk star"
  ],
  "galleryBanner": {
    "color": "#222222",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Dusk Star Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/color-dark.json"
      },
      {
        "label": "Dusk Star Light",
        "uiTheme": "vs",
        "path": "./themes/color-light.json"
      }
    ],
    "iconThemes": [
      {
        "id": "dusk-star-icon",
        "label": "Dusk Star",
        "description": "Folder-only icon theme for Dusk Star",
        "path": "./themes/file-icon.json"
      }
    ]
  },
  "scripts": {
    "validate": "python3 scripts/validate.py",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vioulo/dusk-star-theme.git"
  },
  "homepage": "https://github.com/vioulo/dusk-star-theme#readme",
  "bugs": {
    "url": "https://github.com/vioulo/dusk-star-theme/issues"
  },
  "license": "MIT"
}
