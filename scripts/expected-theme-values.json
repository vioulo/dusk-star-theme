      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "foreground": "#66D9EF"
    },
    "Object property": {
      "scope": [
        "variable.other.property",
        "variable.other.object.property"
      ],
      "foreground": "#F8F8F2"
    },
    "Property name": {
      "scope": "support.type.property-name",
      "foreground": "#66D9EF"
    },
    "Regular expression": {
      "scope": "string.regexp",
      "foreground": "#AE81FF"
    },
    "Storage": {
      "scope": "storage",
      "foreground": "#FF4D82",
      "fontStyle": ""
    },
    "Symbol constant": {
      "scope": "constant.other.symbol",
      "foreground": "#AE81FF"
    },
    "Tag name": {
      "scope": "entity.name.tag",
      "foreground": "#FF4D82",
      "fontStyle": ""
    }
