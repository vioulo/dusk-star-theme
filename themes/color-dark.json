{
	"$schema": "vscode://schemas/color-theme",
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": "#66D9EF",
		"type": "#A6E22E",
		"class": "#A6E22E",
		"enum": "#A6E22E",
		"interface": "#A6E22E",
		"struct": "#A6E22E",
		"typeParameter": "#66D9EF",
		"parameter": {
			"foreground": "#FD971F",
			"italic": true
		},
		"variable": "#F8F8F2",
		"property": "#F8F8F2",
		"enumMember": "#A8FDB3",
		"event": "#A6E22E",
		"function": "#A6E22E",
		"method": "#A6E22E",
		"macro": "#FF4D82",
		"keyword": "#FF4D82",
		"modifier": "#FF4D82",
		"comment": "#918C7F",
		"string": "#E6DB74",
		"number": "#AE81FF",
		"regexp": "#AE81FF",
		"operator": "#FF4D82",
		"decorator": "#66D9EF"
	},
	"tokenColors": [
		{
			"settings": {
				"foreground": "#F8F8F2"
			}
		},
		{
			"name": "Comment",
			"scope": "comment",
			"settings": {
				"foreground": "#918C7F"
			}
		},
		{
			"name": "String",
			"scope": "string",
			"settings": {
				"foreground": "#E6DB74"
			}
		},
		{
			"name": "Number",
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#AE81FF"
			}
		},
		{
			"name": "Built-in constant",
			"scope": "constant.language",
			"settings": {
				"foreground": "#AE81FF",
				"fontStyle": "bold"
			}
		},
		{
			"name": "User-defined constant",
			"scope": [
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#A8FDB3"
			}
		},
		{
			"name": "Constant variable",
			"scope": "variable.other.constant",
			"settings": {
				"foreground": "#A8FDB3"
			}
		},
		{
			"name": "Symbol constant",
			"scope": "constant.other.symbol",
			"settings": {
				"foreground": "#A8FDB3"
			}
		},
		{
			"name": "Escape character",
			"scope": "constant.character.escape",
			"settings": {
				"foreground": "#FD971F"
			}
		},
		{
			"name": "Regular expression",
			"scope": "string.regexp",
			"settings": {
				"foreground": "#AE81FF"
			}
		},
		{
			"scope": "constant.other.class",
			"settings": {
				"foreground": "#FD971F"
			}
		},
		{
			"name": "Variable",
			"scope": "variable",
			"settings": {
				"fontStyle": "",
				"foreground": "#F8F8F2"
			}
		},
		{
			"name": "Object property",
			"scope": [
				"variable.other.property",
				"variable.other.object.property"
			],
			"settings": {
				"foreground": "#F8F8F2"
			}
		},
		{
			"name": "Language variable",
			"scope": "variable.language",
			"settings": {
				"foreground": "#FF4D82"
			}
		},
		{
			"name": "Keyword",
			"scope": "keyword",
			"settings": {
				"foreground": "#FF4D82"
			}
		},
		{
			"name": "Storage",
			"scope": "storage",
			"settings": {
				"fontStyle": "",
				"foreground": "#FF4D82"
			}
		},
		{
			"name": "Storage type",
			"scope": "storage.type",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Class and type name",
			"scope": [
				"entity.name.type.class",
				"entity.name.type",
				"entity.name.type.interface",
				"entity.name.type.enum",
				"entity.name.type.struct",
				"entity.name.type.alias",
				"entity.name.type.type-parameter",
				"entity.name.class"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "Namespace or module",
			"scope": [
				"entity.name.namespace",
				"entity.name.module"
			],
			"settings": {
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Label",
			"scope": "entity.name.label",
			"settings": {
				"foreground": "#FD971F"
			}
		},
		{
			"name": "Inherited class",
			"scope": "entity.other.inherited-class",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Function name",
			"scope": [
				"entity.name.function",
				"entity.name.method",
				"variable.function"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "Function argument",
			"scope": "variable.parameter",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#FD971F"
			}
		},
		{
			"name": "Tag name",
			"scope": "entity.name.tag",
			"settings": {
				"fontStyle": "",
				"foreground": "#FF4D82"
			}
		},
		{
			"name": "Tag attribute",
			"scope": "entity.other.attribute-name",
			"settings": {
				"fontStyle": "",
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "Property name",
			"scope": "support.type.property-name",
			"settings": {
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Library function",
			"scope": "support.function",
			"settings": {
				"fontStyle": "",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Library constant",
			"scope": "support.constant",
			"settings": {
				"fontStyle": "",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Library class/type",
			"scope": [
				"support.type",
				"support.class"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Library variable",
			"scope": [
				"support.other.variable",
				"support.variable"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#F8F8F2"
			}
		},
		{
			"name": "Markdown heading",
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Markdown bold",
			"scope": "markup.bold",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown italic",
			"scope": "markup.italic",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown underline",
			"scope": "markup.underline",
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"name": "Markdown link",
			"scope": "markup.underline.link",
			"settings": {
				"fontStyle": "underline",
				"foreground": "#7FB4FF"
			}
		},
		{
			"name": "Markdown inserted",
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "Markdown deleted",
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#FF6B6B"
			}
		},
		{
			"name": "Markdown changed",
			"scope": "markup.changed",
			"settings": {
				"foreground": "#7FB4FF"
			}
		},
		{
			"name": "Markdown quote",
			"scope": "markup.quote",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#918C7F"
			}
		},
		{
			"name": "Markdown raw",
			"scope": [
				"markup.raw",
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#E6DB74"
			}
		},
		{
			"name": "Markdown list",
			"scope": "markup.list",
			"settings": {
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Invalid",
			"scope": "invalid",
			"settings": {
				"fontStyle": "",
				"foreground": "#F8F8F0"
			}
		},
		{
			"name": "Invalid deprecated",
			"scope": "invalid.deprecated",
			"settings": {
				"foreground": "#F8F8F0"
			}
		}
	],
	"colors": {
		"editor.background": "#222222",
		"editor.foreground": "#F8F8F2",
		"editorCursor.foreground": "#F8F8F0",
		"editor.lineHighlightBackground": "#31435A66",
		"editor.selectionBackground": "#365C8A66",
		"editor.selectionHighlightBackground": "#4E7DB833",
		"editor.inactiveSelectionBackground": "#2B496C55",
		"editor.wordHighlightBackground": "#4E7DB833",
		"editor.wordHighlightStrongBackground": "#5C8FCF4D",
		"editor.findMatchBackground": "#4B98FD66",
		"editor.findMatchHighlightBackground": "#4B98FD33",
		"editor.findRangeHighlightBackground": "#3A4B634D",
		"editor.findMatchBorder": "#8EBEFF",
		"editor.findMatchHighlightBorder": "#6E94C0",
		"searchEditor.findMatchBackground": "#4B98FD66",
		"editorLineNumber.foreground": "#939393",
		"editorLineNumber.activeForeground": "#7FB4FF",
		"editorWhitespace.foreground": "#3A4B63",
		"editorGutter.addedBackground": "#7FB4FF",
		"editorGutter.modifiedBackground": "#4B98FD",
		"editorOverviewRuler.addedForeground": "#7FB4FF",
		"editorOverviewRuler.modifiedForeground": "#4B98FD",
		"editorIndentGuide.background1": "#2F2F2F",
		"editorIndentGuide.activeBackground1": "#4A6890",
		"editorGroupHeader.tabsBackground": "#1F1F1F",
		"editorGroupHeader.tabsBorder": "#2A2A2A",

		"sideBar.background": "#222222",
		"sideBar.foreground": "#8A8A8A",
		"sideBar.border": "#2F2F2F",
		"sideBarTitle.foreground": "#A6E22E",
		"sideBarSectionHeader.background": "#222222",
		"sideBarSectionHeader.foreground": "#CCC",
		"statusBar.background": "#222222",
		"statusBar.foreground": "#F8F8F2",
		"statusBar.noFolderBackground": "#222222",
		"statusBar.noFolderForeground": "#F8F8F2",
		"statusBar.border": "#2F2F2F",
		"statusBar.debuggingBackground": "#C2185B",
		"statusBar.debuggingForeground": "#F8F8F0",

		"activityBar.background": "#222222",
		"activityBar.foreground": "#F8F8F2",
		"activityBar.border": "#2F2F2F",
		"activityBarBadge.background": "#BBC1F4",
		"activityBarBadge.foreground": "#222222",
		"titleBar.activeBackground": "#222222",
		"titleBar.inactiveBackground": "#222222",
		"titleBar.activeForeground": "#F8F8F2",
		"titleBar.inactiveForeground": "#BFC9D8",
		"titleBar.border": "#2F2F2F",
		"tab.activeBackground": "#222222",
		"tab.activeForeground": "#F8F8F2",
		"tab.activeBorderTop": "#6FA3E5",
		"tab.activeBorder": "#222222",
		"tab.activeModifiedBorder": "#4B98FD",
		"tab.inactiveBackground": "#2A2A2A",
		"tab.inactiveForeground": "#9A9A9A",
		"tab.hoverBackground": "#303030",
		"tab.unfocusedHoverBackground": "#2A2A2A",
		"tab.unfocusedActiveBorderTop": "#4D79AD",
		"tab.unfocusedActiveBorder": "#222222",
		"tab.inactiveModifiedBorder": "#5C7FA8",
		"tab.border": "#2F2F2F",
		"input.background": "#262626",
		"input.foreground": "#F8F8F2",
		"input.border": "#3E4F66",
		"button.background": "#2F6FB5",
		"button.foreground": "#F5FAFF",
		"button.hoverBackground": "#3475BC",
		"button.secondaryBackground": "#365D87",
		"button.secondaryForeground": "#EAF3FF",
		"button.secondaryHoverBackground": "#4170A1",
		"list.hoverBackground": "#2A456866",
		"list.activeSelectionBackground": "#31527777",
		"list.inactiveSelectionBackground": "#2B496C66",
		"list.focusBackground": "#31527777",
		"list.focusForeground": "#EAF3FF",
		"gitDecoration.addedResourceForeground": "#7FB4FF",
		"gitDecoration.untrackedResourceForeground": "#7FB4FF",
		"gitDecoration.stageModifiedResourceForeground": "#4B98FD",
		"gitDecoration.modifiedResourceForeground": "#4B98FD",
		"gitDecoration.ignoredResourceForeground": "#6E7681",
		"gitDecoration.renamedResourceForeground": "#99C4FF",
		"gitDecoration.submoduleResourceForeground": "#7FB4FF",
    	"menu.border": "#2F2F2F",
		"menu.background": "#222222",
		"menu.foreground": "#F8F8F2",
		"menubar.selectionBackground": "#324B6A",
		"menubar.selectionForeground": "#F8F8F2"
	},
	"name": "dusk-star-theme"
}
