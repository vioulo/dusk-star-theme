{
	"$schema": "vscode://schemas/color-theme",
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"namespace": "#66D9EF",
		"type": "#A6E22E",
		"class": "#A6E22E",
		"enum": "#A6E22E",
		"interface": "#A6E22E",
		"struct": "#A6E22E",
		"typeParameter": "#66D9EF",
		"parameter": {
			"foreground": "#FD971F",
			"italic": true
		},
		"variable": "#F8F8F2",
		"property": "#F8F8F2",
		"enumMember": "#AE81FF",
		"event": "#A6E22E",
		"function": "#A6E22E",
		"method": "#A6E22E",
		"macro": "#FF4D82",
		"keyword": "#FF4D82",
		"modifier": "#FF4D82",
		"comment": "#918C7F",
		"string": "#E6DB74",
		"number": "#AE81FF",
		"regexp": "#AE81FF",
		"operator": "#FF4D82",
		"decorator": "#66D9EF"
	},
	"tokenColors": [
		{
			"settings": {
				"foreground": "#F8F8F2"
			}
		},
		{
			"name": "Comment",
			"scope": "comment",
			"settings": {
				"foreground": "#918C7F"
			}
		},
		{
			"name": "String",
			"scope": "string",
			"settings": {
				"foreground": "#E6DB74"
			}
		},
		{
			"name": "Number",
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#AE81FF"
			}
		},
		{
			"name": "Built-in constant",
			"scope": "constant.language",
			"settings": {
				"foreground": "#AE81FF",
				"fontStyle": "bold"
			}
		},
		{
			"name": "User-defined constant",
			"scope": [
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#AE81FF"
			}
		},
		{
			"name": "Constant variable",
			"scope": "variable.other.constant",
			"settings": {
				"foreground": "#AE81FF"
			}
		},
		{
			"name": "Symbol constant",
			"scope": "constant.other.symbol",
			"settings": {
				"foreground": "#AE81FF"
			}
		},
		{
			"name": "Escape character",
			"scope": "constant.character.escape",
			"settings": {
				"foreground": "#FD971F"
			}
		},
		{
			"name": "Regular expression",
			"scope": "string.regexp",
			"settings": {
				"foreground": "#AE81FF"
			}
		},
		{
			"scope": "constant.other.class",
			"settings": {
				"foreground": "#FD971F"
			}
		},
		{
			"name": "Variable",
			"scope": "variable",
			"settings": {
				"fontStyle": "",
				"foreground": "#F8F8F2"
			}
		},
		{
			"name": "Object property",
			"scope": [
				"variable.other.property",
				"variable.other.object.property"
			],
			"settings": {
				"foreground": "#F8F8F2"
			}
		},
		{
			"name": "Language variable",
			"scope": "variable.language",
			"settings": {
				"foreground": "#FF4D82"
			}
		},
		{
			"name": "Keyword",
			"scope": "keyword",
			"settings": {
				"foreground": "#FF4D82"
			}
		},
		{
			"name": "Storage",
			"scope": "storage",
			"settings": {
				"fontStyle": "",
				"foreground": "#FF4D82"
			}
		},
		{
			"name": "Storage type",
			"scope": "storage.type",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Class and type name",
			"scope": [
				"entity.name.type.class",
				"entity.name.type",
				"entity.name.type.interface",
				"entity.name.type.enum",
				"entity.name.type.struct",
				"entity.name.type.alias",
				"entity.name.type.type-parameter",
				"entity.name.class"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "Namespace or module",
			"scope": [
				"entity.name.namespace",
				"entity.name.module"
			],
			"settings": {
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Label",
			"scope": "entity.name.label",
			"settings": {
				"foreground": "#FD971F"
			}
		},
		{
			"name": "Inherited class",
			"scope": "entity.other.inherited-class",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Function name",
			"scope": [
				"entity.name.function",
				"entity.name.method",
				"variable.function"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "Function argument",
			"scope": "variable.parameter",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#FD971F"
			}
		},
		{
			"name": "Tag name",
			"scope": "entity.name.tag",
			"settings": {
				"fontStyle": "",
				"foreground": "#FF4D82"
			}
		},
		{
			"name": "Tag attribute",
			"scope": "entity.other.attribute-name",
			"settings": {
				"fontStyle": "",
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "Property name",
			"scope": "support.type.property-name",
			"settings": {
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Library function",
			"scope": "support.function",
			"settings": {
				"fontStyle": "",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Library constant",
			"scope": "support.constant",
			"settings": {
				"fontStyle": "",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Library class/type",
			"scope": [
				"support.type",
				"support.class"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Library variable",
			"scope": [
				"support.other.variable",
				"support.variable"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#F8F8F2"
			}
		},
		{
			"name": "Markdown heading",
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Markdown bold",
			"scope": "markup.bold",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown italic",
			"scope": "markup.italic",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown underline",
			"scope": "markup.underline",
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"name": "Markdown link",
			"scope": "markup.underline.link",
			"settings": {
				"fontStyle": "underline",
				"foreground": "#7FB4FF"
			}
		},
		{
			"name": "Markdown inserted",
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "Markdown deleted",
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#FF6B6B"
			}
		},
		{
			"name": "Markdown changed",
			"scope": "markup.changed",
			"settings": {
				"foreground": "#7FB4FF"
			}
		},
		{
			"name": "Markdown quote",
			"scope": "markup.quote",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#918C7F"
			}
		},
		{
			"name": "Markdown raw",
			"scope": [
				"markup.raw",
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#E6DB74"
			}
		},
		{
			"name": "Markdown list",
			"scope": "markup.list",
			"settings": {
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Invalid",
			"scope": "invalid",
			"settings": {
				"fontStyle": "",
				"foreground": "#F8F8F0"
			}
		},
		{
			"name": "Invalid deprecated",
			"scope": "invalid.deprecated",
			"settings": {
				"foreground": "#F8F8F0"
			}
		}
	],
