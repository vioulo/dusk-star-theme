{
  "$schema": "vscode://schemas/color-theme",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#2F4F7A",
    "type": "#5A7A1D",
    "class": "#5A7A1D",
    "enum": "#5A7A1D",
    "interface": "#5A7A1D",
    "struct": "#5A7A1D",
    "typeParameter": "#1A73B8",
    "parameter": {
      "foreground": "#A65300",
      "italic": true
    },
    "variable": "#2D465D",
    "property": "#2D465D",
    "enumMember": "#6D4BC4",
    "event": "#2E66E8",
    "function": "#2E66E8",
    "method": "#2E66E8",
    "macro": "#C2185B",
    "keyword": "#C2185B",
    "modifier": "#C2185B",
    "comment": "#677186",
    "string": "#3F7E50",
    "number": "#7A4DD8",
    "regexp": "#7A4DD8",
    "operator": "#C2185B",
    "decorator": "#1A73B8"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#2E3440"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#677186"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#3F7E50"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#7A4DD8"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "foreground": "#7A4DD8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "User-defined constant",
      "scope": [
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#6D4BC4"
      }
    },
    {
      "name": "Constant variable",
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#6D4BC4"
      }
    },
    {
      "name": "Symbol constant",
      "scope": "constant.other.symbol",
      "settings": {
        "foreground": "#6D4BC4"
      }
    },
    {
      "name": "Escape character",
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#A65300"
      }
    },
    {
      "name": "Regular expression",
      "scope": "string.regexp",
      "settings": {
        "foreground": "#7A4DD8"
      }
    },
    {
      "scope": "constant.other.class",
      "settings": {
        "foreground": "#A65300"
      }
    },
    {
      "name": "Variable",
      "scope": "variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#2D465D"
      }
    },
    {
      "name": "Object property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#2D465D"
      }
    },
    {
      "name": "Language variable",
      "scope": "variable.language",
      "settings": {
        "foreground": "#C2185B"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "foreground": "#C2185B"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#C2185B"
      }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Class and type name",
      "scope": [
        "entity.name.type.class",
        "entity.name.type",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.alias",
        "entity.name.type.type-parameter",
        "entity.name.class"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#5A7A1D"
      }
    },
    {
      "name": "Namespace or module",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#2F4F7A"
      }
    },
    {
      "name": "Label",
      "scope": "entity.name.label",
      "settings": {
        "foreground": "#A65300"
      }
    },
    {
      "name": "Inherited class",
      "scope": "entity.other.inherited-class",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Function name",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#2E66E8"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#A65300"
      }
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#C2185B"
      }
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#2D72B2"
      }
    },
    {
      "name": "Property name",
      "scope": "support.type.property-name",
      "settings": {
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Library constant",
      "scope": "support.constant",
      "settings": {
        "fontStyle": "",
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.class"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Library variable",
      "scope": [
        "support.other.variable",
        "support.variable"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#2D465D"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#2F4F7A"
      }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown underline",
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown link",
      "scope": "markup.underline.link",
      "settings": {
        "fontStyle": "underline",
        "foreground": "#2F6FB5"
      }
    },
    {
      "name": "Markdown inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#2F7F4F"
      }
    },
    {
      "name": "Markdown deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#C62828"
      }
    },
    {
      "name": "Markdown changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#2F6FB5"
      }
    },
    {
      "name": "Markdown quote",
      "scope": "markup.quote",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#677186"
      }
    },
    {
      "name": "Markdown raw",
      "scope": [
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#3F7E50"
      }
    },
    {
      "name": "Markdown list",
      "scope": "markup.list",
      "settings": {
        "foreground": "#2F4F7A"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#D32F2F"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#D32F2F"
      }
    },
    {
      "name": "Invalid illegal",
      "scope": "invalid.illegal",
      "settings": {
        "foreground": "#D32F2F"
      }
    }
  ],
