{
  "$schema": "vscode://schemas/color-theme",
  "tokenColors": [
    {
      "settings": {
        "foreground": "#2E3440"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#677186"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#3F7E50"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#7A4DD8"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "foreground": "#7A4DD8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "User-defined constant",
      "scope": [
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#2A804A"
      }
    },
    {
      "scope": "constant.other.class",
      "settings": {
        "foreground": "#A65300"
      }
    },
    {
      "name": "Variable",
      "scope": "variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#2D465D"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "foreground": "#C2185B"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#C2185B"
      }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.type.class",
      "settings": {
        "fontStyle": "",
        "foreground": "#5A7A1D"
      }
    },
    {
      "name": "Inherited class",
      "scope": "entity.other.inherited-class",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#2E66E8"
      }
    },
    {
      "name": "Function call",
      "scope": "meta.function-call",
      "settings": {
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#A65300"
      }
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#C2185B"
      }
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#2F7ABF"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Library constant",
      "scope": "support.constant",
      "settings": {
        "fontStyle": "",
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Library class/type",
      "scope": [
        "support.type",
        "support.class"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#1A73B8"
      }
    },
    {
      "name": "Library variable",
      "scope": "support.other.variable",
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#D32F2F"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#D32F2F"
      }
    }
  ],
  "colors": {
    "editor.background": "#F4F7FB",
    "editor.foreground": "#2E3440",
    "editorCursor.foreground": "#2B3D55",
    "editor.lineHighlightBackground": "#DCE7F566",
    "editor.selectionBackground": "#D7E9FF",
    "editor.inactiveSelectionBackground": "#DCE8F833",
    "editor.wordHighlightBackground": "#2F6FB51F",
    "editor.wordHighlightStrongBackground": "#1F5FA826",
    "editor.wordHighlightBorder": "#2F6FB5",
    "editor.wordHighlightStrongBorder": "#1F5FA8",
    "editor.findMatchBackground": "#BBD2F266",
    "editor.findMatchHighlightBackground": "#D5E3F74D",
    "editor.findRangeHighlightBackground": "#E6EEF933",
    "editor.findMatchBorder": "#7EA5D8",
    "editor.findMatchHighlightBorder": "#AFC6E4",
    "searchEditor.findMatchBackground": "#BBD2F266",
    "editorLineNumber.foreground": "#7F8B9E",
    "editorLineNumber.activeForeground": "#5F6B7C",
    "editorCodeLens.foreground": "#657082",
    "editorWhitespace.foreground": "#C3CFDE",
    "editorGutter.addedBackground": "#2F6FB5",
    "editorGutter.modifiedBackground": "#2F5FA8",
    "editorOverviewRuler.addedForeground": "#2F6FB5",
    "editorOverviewRuler.modifiedForeground": "#2F5FA8",
    "editorIndentGuide.background1": "#CBD7E8",
    "editorIndentGuide.activeBackground1": "#8FB2DE",
    "editorGroupHeader.tabsBackground": "#DFE7F4",
    "editorGroupHeader.tabsBorder": "#C6D3E6",

    "sideBar.background": "#EEF3FA",
    "sideBar.foreground": "#4D5A6E",
    "sideBar.border": "#D3DDEB",
    "sideBarTitle.foreground": "#2F4F7A",
    "sideBarSectionHeader.background": "#E6EDF8",
    "sideBarSectionHeader.foreground": "#2F4F7A",

    "statusBar.background": "#E9EFF8",
    "statusBar.foreground": "#3C506A",
    "statusBar.noFolderBackground": "#E9EFF8",
    "statusBar.noFolderForeground": "#3C506A",
    "statusBar.border": "#CED8E8",
    "statusBar.debuggingBackground": "#C43E73",
    "statusBar.debuggingForeground": "#FFFFFF",

    "activityBar.background": "#E9EFF8",
    "activityBar.foreground": "#425670",
    "activityBar.border": "#CED8E8",
    "activityBarBadge.background": "#2F7F4F",
    "activityBarBadge.foreground": "#FFFFFF",
    "titleBar.activeBackground": "#E9EFF8",
    "titleBar.inactiveBackground": "#E3EAF5",
    "titleBar.activeForeground": "#2E3440",
    "titleBar.inactiveForeground": "#5F6F84",
    "titleBar.border": "#CED8E8",
    "tab.activeBackground": "#F7FAFF",
    "tab.activeForeground": "#1F2D3D",
    "tab.activeBorderTop": "#6FA3E5",
    "tab.activeBorder": "#F7FAFF",
    "tab.activeModifiedBorder": "#2F5FA8",
    "tab.inactiveBackground": "#E3EAF5",
    "tab.inactiveForeground": "#5E6D83",
    "tab.hoverBackground": "#EAF1FB",
    "tab.unfocusedHoverBackground": "#E6EDF8",
    "tab.unfocusedActiveBorderTop": "#90A8C9",
    "tab.unfocusedActiveBorder": "#F7FAFF",
    "tab.inactiveModifiedBorder": "#7C9EC8",
    "tab.border": "#C6D3E6",
    "input.background": "#FFFFFF",
    "input.foreground": "#2E3440",
    "input.border": "#A8BAD2",
    "focusBorder": "#2F6FB5",
    "button.background": "#3475BC",
    "button.foreground": "#F6FAFF",
    "button.hoverBackground": "#2F6FB5",
    "button.secondaryBackground": "#D7E3F4",
    "button.secondaryForeground": "#33465E",
    "button.secondaryHoverBackground": "#C9D8EE",
    "list.hoverBackground": "#D1E1F4",
    "list.activeSelectionBackground": "#ADC6E4",
    "list.inactiveSelectionBackground": "#BDD2EA",
    "list.focusBackground": "#ADC6E4",
    "list.activeSelectionForeground": "#16273A",
    "list.inactiveSelectionForeground": "#22364C",
    "list.focusForeground": "#16273A",
    "list.focusOutline": "#00000000",
    "list.focusAndSelectionOutline": "#00000000",
    "list.inactiveFocusOutline": "#00000000",
    "gitDecoration.addedResourceForeground": "#2F6FB5",
    "gitDecoration.untrackedResourceForeground": "#2F6FB5",
    "gitDecoration.stageModifiedResourceForeground": "#2F5FA8",
    "gitDecoration.modifiedResourceForeground": "#2F5FA8",
    "gitDecoration.ignoredResourceForeground": "#8A8A8D",
    "gitDecoration.renamedResourceForeground": "#3F6FB5",
    "gitDecoration.submoduleResourceForeground": "#2F6FB5",
    "menu.border": "#D3DDEB",
    "menu.background": "#F8FAFD",
    "menu.foreground": "#2E3440",
    "menubar.selectionBackground": "#D5E3F6",
    "menubar.selectionForeground": "#2E3440"
  },
  "name": "dusk-star-theme-light"
}
