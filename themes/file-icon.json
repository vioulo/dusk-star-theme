{
  "$schema": "vscode://schemas/icon-theme",
  "iconDefinitions": {
    "_dark_folder": {
      "iconPath": "../imgs/folder-close.svg"
    },
    "_dark_folder_open": {
      "iconPath": "../imgs/folder-open.svg"
    },
    "_light_folder": {
      "iconPath": "../imgs/folder-close-light.svg"
    },
    "_light_folder_open": {
      "iconPath": "../imgs/folder-open-light.svg"
    }
  },
  "folder": "_dark_folder",
  "folderExpanded": "_dark_folder_open",
  "light": {
    "folder": "_light_folder",
    "folderExpanded": "_light_folder_open"
  },
  "hidesExplorerArrows": true
}
